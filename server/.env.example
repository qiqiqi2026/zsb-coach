# 复制为 server/.env 后修改

# 你的开发者邮箱：用这个邮箱注册的账号会自动成为「开发者账号」，
# 登录后直接进入开发者版本，可查看所有用户、在线人数、答题统计等。
DEV_EMAIL=

# 可选：自定义后端端口
# PORT=8140

# 可选：本机 Ollama 地址与模型
# OLLAMA_BASE=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3-8b:latest

# 可选：云端兜底 AI（本机 Ollama 不可用时自动切换）
# CLOUD_BASE=https://api.siliconflow.cn/v1
# CLOUD_KEY=sk-xxxx
# CLOUD_MODEL=Qwen/Qwen2.5-7B-Instruct
